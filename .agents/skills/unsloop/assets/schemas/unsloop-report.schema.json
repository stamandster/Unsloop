{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:unsloop:schema:report:1.0",
  "title": "Unsloop Report",
  "type": "object",
  "required": ["schema_version", "mode", "artifact", "evidence_boundary", "findings", "readiness"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "mode": {"enum": ["Review", "Write", "Audit"]},
    "depth": {"enum": ["brief", "standard", "deep"]},
    "artifact": {
      "type": "object",
      "required": ["identifier", "inspected_boundary"],
      "properties": {
        "identifier": {"type": "string"},
        "version": {"type": ["string", "null"]},
        "inspected_boundary": {"type": "string"}
      },
      "additionalProperties": false
    },
    "evidence_boundary": {
      "type": "object",
      "required": ["available", "unavailable", "limitations"],
      "properties": {
        "available": {"type": "array", "items": {"type": "string"}},
        "unavailable": {"type": "array", "items": {"type": "string"}},
        "limitations": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "location", "observation", "classification", "confidence", "severity", "action"],
        "properties": {
          "id": {"type": "string", "pattern": "^FND-[A-Za-z0-9_-]+$"},
          "location": {"type": "string"},
          "observation": {"type": "string"},
          "classification": {"type": "string"},
          "consequence": {"type": ["string", "null"]},
          "evidence": {"type": "array", "items": {"type": "string"}},
          "confidence": {"enum": ["Low", "Moderate", "High"]},
          "severity": {"enum": ["Low", "Moderate", "High", "Critical"]},
          "preserve": {"type": ["string", "null"]},
          "action": {"type": "string"},
          "proposed_correction": {
            "type": ["object", "null"],
            "properties": {
              "classification": {"enum": ["Presentation-only", "Meaning-changing"]},
              "summary": {"type": "string"},
              "semantic_effect": {"type": "string"},
              "downstream_effect": {"type": ["string", "null"]},
              "decision_owner": {"type": ["string", "null"]},
              "disposition": {"enum": ["Proposed", "Accepted", "Partially accepted", "Rejected", "Revision requested", "Applied", "Superseded"]}
            },
            "required": ["classification", "summary", "semantic_effect", "disposition"],
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "audit_state": {
      "type": "object",
      "required": ["artifact_unchanged", "mutation_authorization"],
      "properties": {
        "artifact_unchanged": {"type": "boolean"},
        "mutation_authorization": {"enum": ["None", "Proposals only", "Presentation-only edits", "Specified meaning-changing edits"]},
        "revised_artifact": {"type": ["string", "null"]},
        "authorized_scope": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "writing_pattern_assessment": {
      "type": "object",
      "required": ["assessment_name", "authorship_boundary", "pattern_scores", "measurements", "assistance_provenance", "external_detector_reports"],
      "properties": {
        "assessment_name": {"const": "Writing-Pattern and Assistance Audit"},
        "authorship_boundary": {"const": "Not assessable from prose alone"},
        "pattern_scores": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["dimension", "direction", "score", "basis"],
            "properties": {
              "dimension": {"enum": ["Specificity", "Authorial voice", "Voice fidelity", "Redundancy", "Formulaicity", "Abstraction", "Slop density"]},
              "direction": {"enum": ["higher-is-better", "higher-is-worse"]},
              "score": {"type": ["number", "null"], "minimum": 1, "maximum": 5},
              "confidence": {"type": ["string", "null"], "enum": ["Low", "Moderate", "High", null]},
              "basis": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "measurements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name", "value", "method", "coverage", "limitations"],
            "properties": {
              "name": {"type": "string"},
              "value": {"type": ["number", "string"]},
              "method": {"type": "string"},
              "coverage": {"type": "string"},
              "baseline": {"type": ["string", "null"]},
              "limitations": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        },
        "assistance_provenance": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["evidence", "status", "scope", "limitation"],
            "properties": {
              "evidence": {"type": "string"},
              "status": {"enum": ["Observed", "Reported", "Unverified", "Unavailable"]},
              "scope": {"type": "string"},
              "limitation": {"type": "string"}
            },
            "additionalProperties": false
          }
        },
        "external_detector_reports": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["tool", "version", "date", "input_boundary", "reported_result", "threshold", "limitations"],
            "properties": {
              "tool": {"type": "string"},
              "version": {"type": ["string", "null"]},
              "date": {"type": ["string", "null"]},
              "input_boundary": {"type": "string"},
              "reported_result": {"type": "string"},
              "threshold": {"type": ["string", "null"]},
              "limitations": {"type": "array", "items": {"type": "string"}}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "records": {
      "type": "object",
      "additionalProperties": {"type": "array", "items": {"type": "object"}}
    },
    "readiness": {
      "type": "object",
      "required": ["state", "unresolved_actions"],
      "properties": {
        "state": {"enum": ["Ready", "Ready with noted limitations", "Provisional—decision required", "Not ready—evidence or authorization missing"]},
        "unresolved_actions": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "out_of_scope": {"type": "array", "items": {"type": "string"}}
  },
  "allOf": [
    {
      "if": {
        "properties": {"mode": {"const": "Audit"}},
        "required": ["mode"]
      },
      "then": {"required": ["audit_state"]}
    },
    {
      "if": {"required": ["writing_pattern_assessment"]},
      "then": {
        "properties": {"mode": {"const": "Audit"}},
        "required": ["audit_state"]
      }
    }
  ],
  "additionalProperties": false
}
